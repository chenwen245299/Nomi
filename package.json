{
  "name": "nomi",
  "private": true,
  "version": "0.1.0",
  "description": "Nomi cross-platform desktop application",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/sync-vditor-assets.mjs && vite",
    "build": "node scripts/sync-vditor-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "env:check": "tauri info",
    "lint": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check": "pnpm lint && pnpm format:check && pnpm build && pnpm lint:rust",
    "postinstall": "node scripts/fetch-pdfium.mjs && node scripts/sync-vditor-assets.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "@remixicon/react": "^4.9.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.14",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "maplibre-gl": "^6.6.0",
    "marked": "^18.0.10",
    "pmtiles": "^4.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-web": "0.21.2",
    "supercluster": "^9.0.0",
    "vditor": "^3.11.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-native-web": "^0.21.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "react-native": "0.87.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.6"
  }
}
