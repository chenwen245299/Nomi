{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and every window torn off from a tab",
  "windows": ["main", "tab-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-background-color",
    "core:window:allow-start-dragging",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "dialog:default",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}
